{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/registry.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.track.generate.config.ts",
    "generate:accounts": "SEEKALIVE_DB_MIGRATION_TRACK=accounts pnpm run generate",
    "generate:security": "SEEKALIVE_DB_MIGRATION_TRACK=security pnpm run generate",
    "generate:profiles": "SEEKALIVE_DB_MIGRATION_TRACK=profiles pnpm run generate",
    "generate:feed": "SEEKALIVE_DB_MIGRATION_TRACK=feed pnpm run generate",
    "check": "for track in accounts security profiles feed; do SEEKALIVE_DB_MIGRATION_TRACK=$track drizzle-kit check --config ./drizzle.track.generate.config.ts || exit $?; done",
    "migrate": "drizzle-kit migrate --config ./drizzle.track.migrate.config.ts",
    "migrate:accounts": "SEEKALIVE_DB_MIGRATION_TRACK=accounts pnpm run migrate",
    "migrate:security": "SEEKALIVE_DB_MIGRATION_TRACK=security pnpm run migrate",
    "migrate:profiles": "SEEKALIVE_DB_MIGRATION_TRACK=profiles pnpm run migrate",
    "migrate:feed": "SEEKALIVE_DB_MIGRATION_TRACK=feed pnpm run migrate",
    "migrate:baseline": "pnpm run migrate:accounts && pnpm run migrate:security && pnpm run migrate:profiles && pnpm run migrate:feed",
    "test:baselines": "node ./scripts/test-migration-baselines.mjs",
    "push": "node ./scripts/push-isolated.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
