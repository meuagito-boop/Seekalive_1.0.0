      "checkConstraints": {
        "feed_posts_audience_valid": {
          "name": "feed_posts_audience_valid",
          "value": "\"audience\" in ('public', 'circles', 'private')"
        },
        "feed_posts_format_valid": {
          "name": "feed_posts_format_valid",
          "value": "\"format\" in ('text', 'media', 'article')"
        },
        "feed_posts_content_valid": {
          "name": "feed_posts_content_valid",
          "value": "(\n        (\"format\" = 'text' and char_length(btrim(\"content\")) between 1 and 280\n          and \"article_title\" is null and \"article_body\" is null\n          and jsonb_typeof(\"media\") = 'array' and jsonb_array_length(\"media\") = 0)\n        or\n        (\"format\" = 'media' and char_length(\"content\") <= 280\n          and \"article_title\" is null and \"article_body\" is null\n          and jsonb_typeof(\"media\") = 'array' and jsonb_array_length(\"media\") between 1 and 8)\n        or\n        (\"format\" = 'article' and char_length(\"content\") <= 280\n          and \"article_title\" is not null and char_length(btrim(\"article_title\")) between 1 and 160\n          and \"article_body\" is not null and char_length(btrim(\"article_body\")) between 1 and 50000\n          and jsonb_typeof(\"media\") = 'array' and jsonb_array_length(\"media\") <= 8)\n      )"
        },
        "feed_posts_version_positive": {
          "name": "feed_posts_version_positive",
          "value": "\"version\" > 0"
        }
      },
      "isRLSEnabled": false
    },
